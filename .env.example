# Jukebox environment files
#
# Quick start:
#   Development:  cp .env.development.example .env.development
#   Production:   cp .env.production.example .env.production
#
# Cloudflare (optional):
#   cp .env.cloudflared.example .env.cloudflared
#   bun run docker:up:cloudflare
#
# Private registry (optional):
#   cp .env.docker.example .env.docker
#   bun run docker:publish
#
# Or run:  bun run setup:dev   /   bun run setup:prod
#
# ── Docker ───────────────────────────────────────────────────────────────────
#
#   bun run docker:up              Build/run locally (image: jukebox:local)
#   bun run docker:publish         Multi-arch build + push (needs .env.docker)
#   bun run docker:up:registry     Run image from .env.docker (no rebuild)
#   bun run docker:up:cloudflare   Registry/tunnel overlay + cloudflared
#
#   JUKEBOX_PORT=3000              Host port (optional)
#   JUKEBOX_IMAGE=                 Compose interpolation only (.env.docker)
#
# ── File roles ─────────────────────────────────────────────────────────────
#
#   .env.development     Local dev (gitignored). Loaded by `bun run dev`.
#   .env.production      App container (gitignored). Spotify, BASE_URL, secrets.
#   .env.cloudflared     Tunnel only (gitignored). Optional — cloudflared overlay.
#   .env.docker          Compose interpolation only (gitignored). Registry/image tag.
#   .env.local           Optional overrides (gitignored). Loaded after the env file above.
#
# ── Required variables ─────────────────────────────────────────────────────
#
#   All environments:
#     SPOTIFY_CLIENT_ID
#     SPOTIFY_CLIENT_SECRET
#     SPOTIFY_REDIRECT_URI
#     ENCRYPTION_KEY
#
#   Production (Docker) also required:
#     BASE_URL                  Public URL (https:// recommended)
#     HOST_SETUP_TOKEN          openssl rand -hex 16
#
#   Production ENCRYPTION_KEY must be ≥ 32 characters (openssl rand -hex 32).
#
# ── Optional ─────────────────────────────────────────────────────────────────
#
#   ALLOW_INSECURE_HTTP=1     Allow http:// BASE_URL in production (LAN / special setups)
#   DEBUG=spotify             Log Spotify API requests/responses (also: sync, or 1 for all)
#   DATABASE_PATH             Default: ./data/jukebox-dev.db (dev) or /data/jukebox.db (prod)
#   PORT=3000
#   SPOTIFY_API_BUDGET_COUNT=90       Global outbound Spotify calls per window (default 90)
#   SPOTIFY_API_BUDGET_WINDOW_MS=30000  Budget window in ms (default 30000)
#   SPOTIFY_DAILY_WARN_CALLS=8000     Diagnostics warning when 24h API calls exceed this
#
# ── Cloudflare Tunnel (optional) ─────────────────────────────────────────────
#
#   .env.cloudflared: TUNNEL_TOKEN — only for docker-compose.cloudflare.yml
#
# See README.md and docs/SECURITY.md for full setup and security notes.
