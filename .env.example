# Jukebox environment files
#
# Quick start:
#   Development:  cp .env.development.example .env.development
#   Production:   cp .env.production.example .env.production
#                 cp .env.cloudflared.example .env.cloudflared
#
# Or run:  bun run setup:dev   /   bun run setup:prod
#
# ── File roles ─────────────────────────────────────────────────────────────
#
#   .env.development     Local dev (gitignored). Loaded by `bun run dev`.
#   .env.production      App container (gitignored). Loaded by Docker jukebox service.
#   .env.cloudflared     Tunnel only (gitignored). Loaded by Docker cloudflared service.
#   .env.local           Optional overrides (gitignored). Loaded after the env file above.
#
# ── Required variables ─────────────────────────────────────────────────────
#
#   All environments:
#     SPOTIFY_CLIENT_ID
#     SPOTIFY_CLIENT_SECRET
#     SPOTIFY_REDIRECT_URI
#     ENCRYPTION_KEY
#
#   Production only (also required):
#     BASE_URL                  https:// tunnel hostname
#     HOST_SETUP_TOKEN          openssl rand -hex 16 — gates host Spotify OAuth
#
#   Production ENCRYPTION_KEY must be ≥ 32 characters (openssl rand -hex 32).
#   Development ENCRYPTION_KEY may use the example dev-only placeholder.
#
# ── Optional ─────────────────────────────────────────────────────────────────
#
#   SPOTIFY_MARKET=US         ISO country code for artist top-tracks (default US)
#   DATABASE_PATH             Default: ./data/jukebox-dev.db (dev) or /data/jukebox.db (prod)
#   PORT=3000
#   HOST_SETUP_TOKEN          Optional in dev; if set, required to connect Spotify locally
#
# ── Production tunnel (separate file) ───────────────────────────────────────
#
#   .env.cloudflared:
#     TUNNEL_TOKEN              From Cloudflare Zero Trust → Tunnels
#
# Do NOT put TUNNEL_TOKEN in .env.production — the app container does not need it.
#
# See README.md and docs/SECURITY.md for full setup and security notes.
