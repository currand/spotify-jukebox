# Jukebox environment files
#
# End users (Docker):
#   cp .env.production.example .env.production
#   docker compose --profile local up -d
#
# Optional profiles:
#   cloudflare — cp .env.cloudflared.example .env.cloudflared
#               docker compose --profile cloudflare up -d
#   tailscale  — cp .env.tailscale.example .env.tailscale
#               docker compose --profile tailscale up -d
#
# Developers (native Bun — see CONTRIBUTING.md):
#   cp .env.development.example .env.development
#   docker compose -f docker-compose-dev.yml --profile dev up --build -d
#
# ── Compose project .env (optional) ───────────────────────────────────────────
#
# HOST_BIND=127.0.0.1          local profile host bind (default localhost; 0.0.0.0 for LAN)
# JUKEBOX_PORT=3000            local profile host port
# JUKEBOX_IMAGE=               override image (default currand/spotify-jukebox:latest)
# JUKEBOX_PLATFORM=linux/amd64 build platform for registry publish scripts
#
# ── File roles ─────────────────────────────────────────────────────────────
#
#   .env.production      App config for all deployment profiles (gitignored)
#   .env.cloudflared     Cloudflare tunnel token (gitignored)
#   .env.tailscale       TS_AUTHKEY, TS_HOSTNAME, TAILNET_DNS_NAME (gitignored)
#   .env.development     Local dev + mock stack (gitignored)
#   .env                 Compose interpolation only (gitignored)
#   .env.local           Optional overrides (gitignored)
#
# See README.md and docs/SECURITY.md for full setup.

# JUKEBOX_IMAGE=currand/spotify-jukebox:latest   default; pin a tag to avoid surprise updates
# JUKEBOX_IMAGE=currand/spotify-jukebox:0.1.0
# HOST_BIND=0.0.0.0
# JUKEBOX_PORT=8080

# ── Sync (optional) ─────────────────────────────────────────────────────────
# SYNC_FAST_POLL=1
#SYNC_END_WINDOW_MS=7000
#SYNC_FALLBACK_INTERVAL_MS=30000
#SYNC_IDLE_INTERVAL_MS=60000

# ── Spotify API budget (optional) ───────────────────────────────────────────
# SPOTIFY_API_BUDGET_COUNT=90
# SPOTIFY_API_BUDGET_WINDOW_MS=30000
# SPOTIFY_DAILY_WARN_CALLS=8000