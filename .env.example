# Jukebox environment files
#
# Quick start:
#   Development:  cp .env.development.example .env.development
#   Production:   cp .env.production.example .env.production
#   Compose vars: cp .env.example .env  (optional — registry / port overrides)
#
# Cloudflare (optional):
#   cp .env.cloudflared.example .env.cloudflared
#   docker compose --profile default --profile tunnel \
#     -f docker-compose.yml -f docker-compose.tunnel.yml up --build -d
#
# Mock Spotify scale testing (optional):
#   docker compose --profile mock up --build -d
#
# ── Docker ───────────────────────────────────────────────────────────────────
#
#   docker compose --profile default up --build -d
#     Production (profile: default)
#
#   docker compose --profile default --profile tunnel \
#     -f docker-compose.yml -f docker-compose.tunnel.yml up --build -d
#     Production + Cloudflare tunnel
#
#   docker compose --profile mock up --build -d
#     Mock stack (jukebox-mock + spotify-mock sidecar)
#
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     -t your-registry/jukebox:latest --push .
#     Multi-arch build + push (needs .env with JUKEBOX_IMAGE)
#
#   docker compose --profile default --env-file .env up -d
#     Run image from JUKEBOX_IMAGE in .env
#
#   JUKEBOX_PORT=3000              Host port (optional)
#   JUKEBOX_IMAGE=                 Compose interpolation only (.env)
#
# ── File roles ─────────────────────────────────────────────────────────────
#
#   .env.development     Local dev + mock stack (gitignored)
#   .env.production      App container for prod (gitignored)
#   .env.cloudflared     Tunnel token only (gitignored)
#   .env                 Compose interpolation only (gitignored)
#   .env.local           Optional overrides (gitignored)
#
# ── Required variables ─────────────────────────────────────────────────────
#
#   Live Spotify (dev or prod):
#     SPOTIFY_CLIENT_ID
#     SPOTIFY_CLIENT_SECRET
#     SPOTIFY_REDIRECT_URI
#     ENCRYPTION_KEY
#
#   Production (Docker) also required:
#     BASE_URL                  Public URL (https recommended)
#     HOST_SETUP_TOKEN          openssl rand -hex 16
#       Not required when BIND_HOST=127.0.0.1, BASE_URL is 127.0.0.1,
#       CLOUDFLARE_TUNNEL=1 (set by docker-compose.tunnel.yml overlay), or
#       DISABLE_HOST_SETUP_TOKEN=1
#
#   Production ENCRYPTION_KEY must be ≥ 32 characters (openssl rand -hex 32).
#
# ── Mock Spotify (dev only) ─────────────────────────────────────────────────
#
#   SPOTIFY_MODE=mock                 Use mock sidecar (JUKEBOX_ENV=development only)
#   SPOTIFY_API_BASE_URL=...          Default https://api.spotify.com/v1
#   SPOTIFY_ACCOUNTS_BASE_URL=...     Default https://accounts.spotify.com
#
# ── Optional ─────────────────────────────────────────────────────────────────
#
#   ALLOW_INSECURE_HTTP=1     Allow http:// BASE_URL in production (LAN)
#   BIND_HOST=127.0.0.1       Listen on loopback only (disables HOST_SETUP_TOKEN)
#   CLOUDFLARE_TUNNEL=1       Set by docker-compose.tunnel.yml; disables HOST_SETUP_TOKEN
#   JUKEBOX_CLOUDFLARE_TUNNEL=1  Alias for CLOUDFLARE_TUNNEL
#   DISABLE_HOST_SETUP_TOKEN=1  Force-disable HOST_SETUP_TOKEN requirement
#   DEBUG=spotify             Log Spotify API requests/responses (also: sync, or 1)
#   DATABASE_PATH             Default: ./data/jukebox-dev.db (dev) or /data/jukebox.db (prod)
#   PORT=3000
#   SPOTIFY_API_BUDGET_COUNT=90
#   SPOTIFY_API_BUDGET_WINDOW_MS=30000
#   JUKEBOX_DEFAULT_RATE_LIMITS='{"add":{"count":3,"windowMs":1200000},"upvote":{"count":10,"windowMs":3600000},"downvote":{"count":3,"windowMs":1800000},"boost":{"count":1,"windowMs":600000},"search":{"count":6,"windowMs":60000},"partySearch":{"count":24,"windowMs":30000}}'
#     optional partial override (omit keys to keep code defaults); DB host settings override this
#   SPOTIFY_DAILY_WARN_CALLS=8000
#   SYNC_FAST_POLL=1              Fixed 10s Spotify sync (legacy; default is adaptive)
#   SYNC_END_WINDOW_MS=7000       Poll this many ms before estimated track end
#   SYNC_FALLBACK_INTERVAL_MS=30000
#   SYNC_IDLE_INTERVAL_MS=60000
#
# ── Cloudflare Tunnel (optional) ─────────────────────────────────────────────
#
#   .env.cloudflared: TUNNEL_TOKEN — only for docker compose profile `tunnel`
#
# See README.md and docs/SECURITY.md for full setup and security notes.

# Docker Compose interpolation — copy to .env (gitignored)
# JUKEBOX_IMAGE=registry.example.com:5555/jukebox:latest
# JUKEBOX_PLATFORM=linux/amd64
# JUKEBOX_PORT=3000
