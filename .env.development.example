# Development — copy to .env.development
# Spotify Developer app #1 (dev redirect URI on 127.0.0.1)
# No Cloudflare tunnel required.

NODE_ENV=development
JUKEBOX_ENV=development

# ── Spotify (required) ──────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# OAuth callback hits the API server on :3000 (not the Vite UI port)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/v1/host/spotify/callback

# ── App URLs ────────────────────────────────────────────────────────────────
# UI URL (Vite dev server) — QR links and post-login redirect
BASE_URL=http://127.0.0.1:5173

# ── Secrets (required) ──────────────────────────────────────────────────────
# Dev placeholder is fine locally; production requires openssl rand -hex 32
ENCRYPTION_KEY=dev-only-change-me

# Optional in dev — if set, enter the same value in Admin → Host setup token
# HOST_SETUP_TOKEN=

# ── Storage / server ────────────────────────────────────────────────────────
DATABASE_PATH=./data/jukebox-dev.db
PORT=3000

# ── Spotify API budget (optional) ───────────────────────────────────────────
# SPOTIFY_API_BUDGET_COUNT=90
# SPOTIFY_API_BUDGET_WINDOW_MS=30000
# SPOTIFY_DAILY_WARN_CALLS=8000

# ── Mock Spotify (optional — dev only) ───────────────────────────────────────
# SPOTIFY_MODE=mock
# SPOTIFY_API_BASE_URL=http://127.0.0.1:8080/v1
# SPOTIFY_ACCOUNTS_BASE_URL=http://127.0.0.1:8080
