# Cloudflare Tunnel — copy to .env.cloudflared (gitignored)
# Used ONLY by the cloudflared service in docker-compose.yml.
#
# Get the token: Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Install connector
#
# Keep this file separate from .env.production so the jukebox app container
# never receives TUNNEL_TOKEN.

TUNNEL_TOKEN=
