# Cloudflare Tunnel — copy to .env.cloudflared (gitignored)
# Optional. Only used with the tunnel compose profile:
#
#   docker compose --profile default --profile tunnel \
#     -f docker-compose.yml -f docker-compose.tunnel.yml up --build -d
#
# Get the token: Cloudflare Zero Trust → Networks → Tunnels → your tunnel
#
# Note: docker-compose.tunnel.yml sets CLOUDFLARE_TUNNEL=1 on the jukebox container,
# which disables the HOST_SETUP_TOKEN requirement. Protect admin with Cloudflare
# Access or your own frontend instead.

TUNNEL_TOKEN=
