# Docker Compose interpolation — copy to .env.docker (gitignored)
#
# These variables are for `docker compose` only (image name, publish targets).
# App secrets (Spotify, ENCRYPTION_KEY, etc.) stay in .env.production.
#
# Usage:
#   cp .env.docker.example .env.docker
#   bun run docker:publish          # build multi-arch + push
#   bun run docker:up:registry      # run published image

# Full image reference: registry/host/path:tag
JUKEBOX_IMAGE=registry.example.com:5555/jukebox:latest

# Target platform for docker:build:registry (default linux/amd64)
# Use linux/arm64 when building on Apple Silicon for an arm64 server
# JUKEBOX_PLATFORM=linux/amd64

# Host port published by docker-compose.yml (optional, default 3000)
# JUKEBOX_PORT=3000
