# Production — copy to .env.production
# Spotify Developer app #2 (HTTPS redirect URI via Cloudflare Tunnel)
# Used by the jukebox service in docker-compose.yml (NOT cloudflared).

NODE_ENV=production
JUKEBOX_ENV=production

# ── Spotify (required) ──────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match hostname in BASE_URL exactly
SPOTIFY_REDIRECT_URI=https://jukebox.yourdomain.com/api/v1/host/spotify/callback
# ISO 3166-1 alpha-2 for artist top-tracks (defaults to US if unset)
SPOTIFY_MARKET=US

# ── App URLs (required) ─────────────────────────────────────────────────────
# Public HTTPS URL (Cloudflare Tunnel hostname)
BASE_URL=https://jukebox.yourdomain.com

# ── Secrets (required) ──────────────────────────────────────────────────────
# Generate: openssl rand -hex 32  (must be ≥ 32 characters)
ENCRYPTION_KEY=

# Generate: openssl rand -hex 16
# Enter this in Admin → Host setup token before Connect Spotify
HOST_SETUP_TOKEN=

# ── Storage / server ────────────────────────────────────────────────────────
DATABASE_PATH=/data/jukebox.db
PORT=3000

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────
# TUNNEL_TOKEN goes in .env.cloudflared (see .env.cloudflared.example).
# Do not add TUNNEL_TOKEN here — the app container must not receive it.
