# Production — copy to .env.production
# Used by the jukebox service in docker-compose.yml
#
# Deployment options:
#   A) Self-hosted (port exposed) — set BASE_URL to your public URL (https via your
#      reverse proxy, or http:// on LAN with ALLOW_INSECURE_HTTP=1). Requires
#      HOST_SETUP_TOKEN unless DISABLE_HOST_SETUP_TOKEN=1.
#   B) Cloudflare Tunnel — use https:// tunnel hostname; see README.md
#      (docker-compose.tunnel.yml sets CLOUDFLARE_TUNNEL=1 — HOST_SETUP_TOKEN not needed)

NODE_ENV=production
JUKEBOX_ENV=production

# ── Spotify (required) ──────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match hostname in BASE_URL exactly
SPOTIFY_REDIRECT_URI=https://jukebox.example.com/api/v1/host/spotify/callback

# ── App URLs (required) ─────────────────────────────────────────────────────
# Public URL guests and admin use (your proxy, LAN IP, or Cloudflare hostname)
BASE_URL=https://jukebox.example.com

# Set to 1 only for http:// LAN parties or when TLS terminates at your proxy
# and Spotify redirect URIs use http:// (uncommon — prefer https:// publicly)
# ALLOW_INSECURE_HTTP=0

# ── Secrets (required) ──────────────────────────────────────────────────────
# Generate: openssl rand -hex 32  (must be ≥ 32 characters)
ENCRYPTION_KEY=

# Generate: openssl rand -hex 16 — required for public (non-tunnel) deployments
# Not required when BIND_HOST=127.0.0.1, BASE_URL uses 127.0.0.1, or CLOUDFLARE_TUNNEL=1
# (CLOUDFLARE_TUNNEL is set by docker-compose.tunnel.yml, not usually in this file)
HOST_SETUP_TOKEN=

# Bind to 127.0.0.1 for localhost-only access (disables HOST_SETUP_TOKEN requirement)
# BIND_HOST=127.0.0.1

# Force-disable HOST_SETUP_TOKEN even on public deployments (not recommended)
# DISABLE_HOST_SETUP_TOKEN=1

# ── Storage / server ────────────────────────────────────────────────────────
DATABASE_PATH=/data/jukebox.db
PORT=3000

# ── Debug / sync (optional) ─────────────────────────────────────────────────
# DEBUG=spotify,sync
# SYNC_FAST_POLL=1
# SYNC_END_WINDOW_MS=7000
# SYNC_FALLBACK_INTERVAL_MS=30000
# SYNC_IDLE_INTERVAL_MS=60000

# ── Spotify API budget (optional) ───────────────────────────────────────────
# SPOTIFY_API_BUDGET_COUNT=90
# SPOTIFY_API_BUDGET_WINDOW_MS=30000
# SPOTIFY_DAILY_WARN_CALLS=8000

# ── Guest default rate limits (optional) ──────────────────────────────────────
# JUKEBOX_DEFAULT_RATE_LIMITS='{"add":{"count":5,"windowMs":1200000}}'

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────
# TUNNEL_TOKEN goes in .env.cloudflared — only when using the tunnel compose profile
