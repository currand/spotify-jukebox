# Copy to .env.production — used by all Docker profiles (local, cloudflare, tailscale).
#
# Generate: openssl rand -hex 32   # ENCRYPTION_KEY

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/v1/host/spotify/callback
BASE_URL=http://127.0.0.1:3000
ENCRYPTION_KEY=
HOST_SETUP_TOKEN=set-this-to-something-secret-or-remove-to-disable-host-session-token

# ── Optional ─────────────────────────────────────────────────────────────────
# ALLOW_INSECURE_HTTP=1      # http:// LAN parties (match Spotify redirect URI)
