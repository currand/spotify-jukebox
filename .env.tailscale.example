# Copy to .env.tailscale (gitignored)
# Used with: docker compose --profile tailscale up -d
#
# Fill all three values below. The app derives BASE_URL and SPOTIFY_REDIRECT_URI from
# TS_HOSTNAME + TAILNET_DNS_NAME (values in .env.production are ignored for URLs).

# Tailscale admin → Settings → Keys → Generate auth key (reusable recommended)
TS_AUTHKEY=

# MagicDNS machine name — app URL: https://<TS_HOSTNAME>.<TAILNET_DNS_NAME>
TS_HOSTNAME=jukebox

# Tailscale admin → DNS → "Tailnet DNS name" (e.g. yak-bebop.ts.net)
TAILNET_DNS_NAME=
