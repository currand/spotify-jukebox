# Copy to .env.tailscale (gitignored)
# Used with: docker compose --profile tailscale up --build -d
#
# Create an auth key: Tailscale admin → Settings → Keys → Generate auth key
# (reusable, or ephemeral for one-time setup). Set BASE_URL in .env.production
# to your Tailscale URL, e.g. http://100.x.x.x:3000 or http://jukebox:3000 with MagicDNS.

TS_AUTHKEY=
