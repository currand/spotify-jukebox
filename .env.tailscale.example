# Copy to .env.tailscale (gitignored)
# Used with: docker compose --profile tailscale up -d
#
# TS_AUTHKEY, TS_HOSTNAME, and TAILNET_DNS_NAME are loaded via env_file (not Compose
# interpolation). The app builds BASE_URL + SPOTIFY_REDIRECT_URI from the hostname vars.

# Tailscale admin → Settings → Keys → Generate auth key (reusable recommended)
TS_AUTHKEY=replace-me

# MagicDNS machine name — app URL becomes https://<TS_HOSTNAME>.<TAILNET_DNS_NAME>
TS_HOSTNAME=jukebox

# Tailscale admin → DNS → "Tailnet DNS name" (e.g. yak-bebop.ts.net)
TAILNET_DNS_NAME=example.ts.net
